{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "listen": "",
      "port": 443,
      "protocol": "vless",
      "tag": "in-443-tcp",
      "settings": {
        "decryption": "ML-KEM-768 (random)",
        "encryption": "ML-KEM-768 (random)"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "/",
          "host": "${DOMAIN_URL}",
          "mode": "packet-up",
          "xPaddingBytes": "100-1000",
          "xPaddingObfsMode": true,
          "xPaddingKey": "32HEX",
          "xPaddingHeader": "Cookie",
          "xPaddingPlacement": "cookie",
          "xPaddingMethod": "tokenish",
          "sessionIDPlacement": "cookie",
          "sessionIDKey": "32HEX",
          "sessionIDTable": "Base62",
          "sessionIDLength": "16-32",
          "seqPlacement": "query",
          "seqKey": "16HEX",
          "uplinkDataPlacement": "cookie,"uplinkDataKey": "v",
          "scMaxEachPostBytes": "1024-4096",
          "noSSEHeader": true,
          "scMaxBufferedPosts": 30,
          "scStreamUpServerSecs": "20-80",
          "serverMaxHeaderBytes": 0,
          "uplinkHTTPMethod": "GET",
          "headers": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:145.0) Gecko/20100101 Firefox/145.0",
            "Accept": "*/*",
            "Accept-Language": "ru-RU,ru;q=0.8,en-US;q=0.5,en;q=0.3",
            "Accept-Encoding": "gzip, deflate, br, zstd",
            "Content-Type": "application/octet-stream"
          },
          "scMinPostsIntervalMs": "",
          "uplinkChunkSize": 0,
          "noGRPCHeader": true,
          "xmux": {
            "maxConcurrency": "16-32",
            "maxConnections": "0",
            "cMaxReuseTimes": 0,
            "hMaxRequestTimes": "600-900",
            "hMaxReusableSecs": "1800-3000",
            "hKeepAlivePeriod": 30
          },
          "enableXmux": true
        },
        "security": "tls",
        "tlsSettings": {
          "serverName": "${DOMAIN_URL}",
          "minVersion": "1.2",
          "maxVersion": "1.3",
          "cipherSuites": "",
          "rejectUnknownSni": false,
          "disableSystemRoot": false,
          "enableSessionResumption": true,
          "certificates": [
            {
              "certificateFile": "/etc/cert.crt",
              "keyFile": "/etc/key.key",
              "ocspStapling": 0,
              "oneTimeLoading": true,
              "usage": "encipherment",
              "buildChain": false,
              "useFile": true
            }
          ],
          "alpn": [
            "h3",
            "h2",
            "http/1.1"
          ],
          "echServerKeys": "",
          "curvePreferences": [],
          "settings": {
            "fingerprint": "firefox",
            "echConfigList": "",
            "pinnedPeerCertSha256": [],
            "verifyPeerCertByName": ""
          }
        },
        "externalProxy": [],
        "finalmask": {
          "quicParams": {
            "congestion": "bbr",
            "debug": false,
            "maxIdleTimeout": 30,
            "keepAlivePeriod": 10,
            "disablePathMTUDiscovery": true,
            "disableStatelessReset": true,
            "maxIncomingStreams": 1024,
            "initStreamReceiveWindow": 8388608,
            "maxStreamReceiveWindow": 8388608,
            "initConnectionReceiveWindow": 20971520,
            "maxConnectionReceiveWindow": 20971520,
            "bbrProfile": "aggressive"
          }
        },
        "sockopt": {
          "tcpFastOpen": true,
          "tproxy": "off",
          "penetrate": false,
          "tcpMaxSeg": 1460,
          "tcpKeepAliveInterval": 60,
          "tcpKeepAliveIdle": 60,
          "tcpUserTimeout": 30000,
          "tcpcongestion": "bbr",
          "acceptProxyProtocol": false,
          "mark": 0,
          "tcpMptcp": false,
          "domainStrategy": "AsIs",
          "dialerProxy": "",
          "V6Only": false,
          "tcpWindowClamp": 0,
          "interface": "",
          "trustedXForwardedFor": [
            "X-Real-IP"
          ],
          "addressPortStrategy": "none",
          "customSockopt": []
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "warp",
      "protocol": "socks",
      "settings": {
        "address": "warp",
        "port": 1080
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "domain": [
          "geoip:ru"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "geosite:youtube"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:google"
        ],
        "outboundTag": "warp"
      }
    ]
  }
}